{
  "name": "ainize",
  "version": "0.2.5",
  "description": "ainize — Ainize (AI + -ize) knowledge-marketplace CLI: publish, verify, live-test (chat), trade and load knowledge patches; `ngram` alias kept (successor of the 2019 ainize-cli)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainblockchain/ainize-cli.git"
  },
  "homepage": "https://github.com/ainblockchain/ainize",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ainize": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainblockchain/ain-js": "^1.15.0",
    "@ainize/core": "^0.2.3",
    "@ainize/node": "^0.2.5",
    "aindrive": "^0.2.4",
    "chalk": "^5.6.2",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
