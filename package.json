{
  "name": "@ngram/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ainize": "./dist/bin.js",
    "ngram": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@ngram/core": "0.1.0",
    "@ngram/node": "0.1.0",
    "chalk": "^5.6.2",
    "yargs": "^18.1.0",
    "aindrive": "^0.2.4",
    "@ainblockchain/ain-js": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.13"
  },
  "description": "ainize — Ainize (AI + -ize) knowledge-marketplace CLI: publish, verify, live-test (chat), trade and load knowledge patches; `ngram` alias kept (successor of the 2019 ainize-cli)"
}
