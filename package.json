{
  "name": "@ainize/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ainize": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@ainize/core": "github:ainblockchain/ainize-core",
    "chalk": "^5.6.2",
    "yargs": "^18.1.0",
    "aindrive": "^0.2.4",
    "@ainblockchain/ain-js": "^1.15.0"
  },
  "devDependencies": {
    "@ainize/node": "github:ainblockchain/ainize-node",
    "@types/node": "^24.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "description": "ainize \u2014 Ainize (AI + -ize) knowledge-marketplace CLI: publish, verify, live-test (chat), trade and load knowledge patches; `ngram` alias kept (successor of the 2019 ainize-cli)",
  "peerDependencies": {
    "@ainize/node": "github:ainblockchain/ainize-node"
  },
  "peerDependenciesMeta": {
    "@ainize/node": {
      "optional": true
    }
  }
}
